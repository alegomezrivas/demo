# Copy this file to a local environment file for development and never commit that copy.
# (It is named without the leading dot only because of tooling restrictions; rename as needed.)
# Allowed: development | test | staging | production
NODE_ENV=development
PORT=5556
LOG_LEVEL=info

# Comma-separated list of allowed browser origins. Leave empty for native apps only.
CORS_ALLOWED_ORIGINS=

# Maximum JSON body size (for example 10kb).
BODY_LIMIT=10kb

# Set to true when running behind a reverse proxy (Render, Fly.io, cloudflared).
TRUST_PROXY=false

# Required, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# X-Mock-* simulation headers. Defaults to true outside production; the server refuses
# to start if it is true in production.
MOCK_SIMULATION_ENABLED=true

# Rate limiting per client IP and window. Login/register and refresh are stricter.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_REFRESH_MAX=20
