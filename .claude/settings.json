{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "permissions": {
    "allow": [
      "Bash(flutter:*)",
      "Bash(dart:*)",
      "Bash(fvm flutter:*)",
      "Bash(fvm dart:*)",
      "Bash(fvm use:*)",
      "Bash(fvm install:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Read(lib/**)",
      "Read(test/**)",
      "Read(config/*.example.json)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(config/dev.json)",
      "Read(config/staging.json)",
      "Read(config/prod.json)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.p12)",
      "Read(**/*.p8)",
      "Read(**/*.mobileprovision)",
      "Read(**/key.properties)",
      "Read(**/google-services.json)",
      "Read(**/GoogleService-Info.plist)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "env": {
    "FLUTTER_SUPPRESS_ANALYTICS": "true",
    "DART_SUPPRESS_ANALYTICS": "true"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validate-bash.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.dart) if [ -d \"$CLAUDE_PROJECT_DIR/.fvm/flutter_sdk\" ] && command -v fvm >/dev/null 2>&1; then (cd \"$CLAUDE_PROJECT_DIR\" && fvm dart format \"$f\") >/dev/null 2>&1; elif command -v dart >/dev/null 2>&1; then dart format \"$f\" >/dev/null 2>&1; fi;; esac; exit 0"
          }
        ]
      }
    ]
  }
}
